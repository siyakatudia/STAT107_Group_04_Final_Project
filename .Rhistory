retrieveQuartersPerYearAvgDFA(2000, "White", "Net worth")
retrieveQuartersPerYearAvgDFA <- function (year, race, category) {
if ( (year %% 1 == 0) && (year > 1989 && year < 2026)) {
identYear <- startsWith(dfa_levels$Date, as.character(year))
identRace <- (dfa_levels$Category == as.character(race))
yearRaceMatch <- (identYear & identRace)
vecCat <- dfa_levels[[category]][yearRaceMatch]
finalAvg <- mean(vecCat)
return(finalAvg)
} else {
stop("Enter an integer year in the range of 1990 to 2025")
}
}
retrieveQuartersPerYearAvgDFA(2000, "White", "Net worth")
retrieveQuartersPerYearAvgDFA(2000.6, "White", "Net worth")
